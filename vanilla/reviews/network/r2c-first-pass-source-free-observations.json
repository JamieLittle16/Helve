  "observations": [
    {
      "id": "R2C-FIRST-PASS-BIOME-REGISTRATION-ORDER",
      "indices": [
        1,
        2,
        3
      ],
      "finding": "MappedRegistry assigns a monotonically appended dense ID at successful registration and resolves byId/getId through that storage; duplicates are rejected."
    },
    {
      "id": "R2C-FIRST-PASS-REGISTRY-DELIVERY",
      "indices": [
        4,
        5,
        6
      ],
      "finding": "Server registry synchronization produces a registry-key-and-ordered-entry-list packet; order and known-pack payload decisions depend on its delegated packing operations."
    },
    {
      "id": "R2C-FIRST-PASS-NETWORK-ORDER",
      "indices": [
        8,
        9,
        10
      ],
      "finding": "Network loader iterates received entries in list order, sequence collects future results in original list order, and registerElements consumes the resulting stream serially under a registry write lock; completion timing alone does not reorder IDs."
    },
    {
      "id": "R2C-FIRST-PASS-BIOME-FACTORY",
      "indices": [
        7
      ],
      "finding": "Biome paletted-container factory uses its stored defaultBiome and biomeStrategy. The strategy's actual holder-to-ID semantics are established separately by previously source-admitted world-state rules."
    },
    {
      "id": "R2C-FIRST-PASS-CHUNK-OUTER",
      "indices": [
        11,
        12,
        13
      ],
      "finding": "Chunk-with-light packet binds its codec to write/read, obtains x/z from the chunk position and constructs chunk and light subpayloads; write emits x and z as two 32-bit signed integers followed by chunkData and lightData."
    },
    {
      "id": "R2C-FIRST-PASS-CHUNK-READ",
      "indices": [
        14,
        15,
        16
      ],
      "finding": "Chunk data decoder reads heightmap codec, varint byte count with a 2097152 positive upper-limit check, section bytes and block entity list; block entity packed X/Z nibbles reconstruct world coordinates; light decoder consumes four bitsets then sky and block layer lists."
    },
    {
      "id": "R2C-FIRST-PASS-BATCH-PACING",
      "indices": [
        17,
        18,
        19
      ],
      "finding": "Server sends batch start, each selected chunk, then finish with count; per-tick quota and unacknowledged limits gate publication; sendChunk constructs a chunk/light packet with null filters; acknowledged remote rate clamps to 0.01..64 and NaN maps to 0.01, unacknowledged count floors at zero and maximum becomes 10."
    }
  ],
  "unresolved": [
    "Client-only installation of received registries and selected known-pack profile, including true 66 numeric biome IDs, is not proved by server-source excerpts.",
    "RegistrySynchronization.packRegistries/packRegistry delegate semantics and full 26.2 client registry ordering must be closed with independent source/observation review.",
    "Per-state heightmap predicates for all 32,366 block-state IDs and the three relevant heightmap types require independent pinned-source closure.",
    "Existing seven independently admitted inner chunk/light writer VARs may be reused, but packet outer envelope, selected world and block-entity-light lifecycle still need VAR/SEM admission.",
    "PlayerChunkSender.collectChunksToSend, client receive/ACK lifecycle, actual stock-client visual observation and independent gate must be qualified before runtime activation."
  ]
}
