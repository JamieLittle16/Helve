  "observations": [
    {
      "ids": [
        1,
        5
      ],
      "rule": "FluidState.isEmpty dispatches to concrete Fluid owner; base Fluid.isEmpty returns false, EmptyFluid overrides true. Completeness of concrete override set is not established."
    },
    {
      "ids": [
        2
      ],
      "rule": "VoxelShape.bounds rejects empty shapes; otherwise returns AABB(minX,minY,minZ,maxX,maxY,maxZ). Axis extrema and AABB construction are further delegates."
    },
    {
      "ids": [
        3,
        4
      ],
      "rule": "AABB.getSize computes arithmetic mean of getXsize/getYsize/getZsize, not volume; getYsize is maxY-minus-minY."
    },
    {
      "ids": [
        6
      ],
      "rule": "Fluid.defaultFluidState returns the stored defaultFluidState field. Initialization/ownership still require review."
    },
    {
      "ids": [
        7
      ],
      "rule": "Block.hasDynamicShape returns its stored dynamicShape flag; source of this flag is separate."
    },
    {
      "ids": [
        8
      ],
      "rule": "Block.isShapeFullBlock uses SHAPE_FULL_BLOCK_CACHE.getUnchecked; it is NOT the BlockStateBase.calculateSolid test used by blocksMotion. Cached shape-full-block loader unreviewed."
    },
    {
      "ids": [
        9,
        10
      ],
      "rule": "Block.registerDefaultState assigns the passed state and StateDefinition.getPossibleStates returns a stored list; neither alone proves all initCache calls or canonical global IDs."
    },
    {
      "ids": [
        11
      ],
      "rule": "Shapes.block returns static BLOCK; its construction and extents remain to review."
    }
